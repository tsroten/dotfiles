#!/usr/bin/env bash
#
# Morning convergence run. Three rules govern everything here:
#
#   1. No step may end the run. Failures warn and continue.
#   2. Nothing may prompt, so it can be left to finish on its own. Auth is the
#      deliberate exception: a login has to be interactive, and there is no
#      point converging a machine you cannot then use.
#   3. Nothing destructive. Anything that would discard work is reported rather
#      than done -- e.g. repos with uncommitted changes are skipped, not stashed.
#
# The summary at the end has two halves, so an unattended run can be reviewed in
# one place: warn() records what went wrong, and recommend() records what is
# left for you to do, with the command to do it.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/code/dotfiles}"
CODE="${CODE:-$HOME/code}"
NVM_DIR="${NVM_DIR:-$HOME/.config/nvm}"

# Make git fail rather than sit at a credential prompt. This isn't the auth
# exception above: that covers the deliberate login steps, whereas this would be
# an opaque stall partway through pulling dozens of repos. A repo that needs
# credentials warns and shows up in the summary instead. Exported so the pull
# inside install.sh inherits it too.
export GIT_TERMINAL_PROMPT=0

# Corepack otherwise asks before downloading a package manager it doesn't have.
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

CURRENT_STEP=""
STEP_COUNT=0
ISSUES=()
FOLLOWUPS=()

step() {
  CURRENT_STEP="$*"
  STEP_COUNT=$((STEP_COUNT + 1))
  printf '\n\033[1;34m==> %s\033[0m\n' "$*"
}

# Warnings print inline for the audit trail and are buffered for the summary,
# since the run is long enough that one 200 lines up is easy to miss.
warn() {
  printf '\033[1;33m  ! %s\033[0m\n' "$*"
  ISSUES+=("${CURRENT_STEP:-start-day}: $*")
}

# Something the run can't do for you, either because it needs a decision or
# because it would be destructive to do unasked. Carries the command to run.
recommend() {
  printf '\033[1;36m  → %s\033[0m\n' "$*"
  FOLLOWUPS+=("$*")
}

# Inline-only: progress chatter that isn't itself a problem, like announcing a
# login prompt. Whether the login then worked is reported separately.
note() {
  printf '\033[1;33m  ! %s\033[0m\n' "$*"
}

ok() {
  printf '\033[1;32m  ✓ %s\033[0m\n' "$*"
}

# On EXIT so the summary still lands if something unexpected kills the run.
summarize() {
  local status=$?
  local entry

  printf '\n\033[1;34m==> Summary\033[0m\n'

  # Nothing should abort the run any more, so if one did, say so rather than
  # letting a short run look like a clean one.
  if [ "$status" -ne 0 ]; then
    printf '\033[1;31m  ✗ run ended early during "%s" (exit %s)\033[0m\n' \
      "${CURRENT_STEP:-startup}" "$status"
  fi

  # macOS ships bash 3.2, where expanding an empty array under `set -u` is an
  # error, so every count is checked before anything expands the array.
  if [ "${#ISSUES[@]}" -eq 0 ] && [ "${#FOLLOWUPS[@]}" -eq 0 ]; then
    if [ "$status" -eq 0 ]; then
      printf '\033[1;32m  ✓ %s steps, nothing to report\033[0m\n' "$STEP_COUNT"
    fi
    return
  fi

  if [ "${#ISSUES[@]}" -gt 0 ]; then
    printf '\033[1;33m  %s warning(s) across %s steps:\033[0m\n' \
      "${#ISSUES[@]}" "$STEP_COUNT"
    for entry in "${ISSUES[@]}"; do
      printf '\033[1;33m    ! %s\033[0m\n' "$entry"
    done
  fi

  # Listed last so it's the final thing on screen -- this is the part that
  # wants acting on, as opposed to the warnings, which are a record.
  if [ "${#FOLLOWUPS[@]}" -gt 0 ]; then
    printf '\033[1;36m  %s thing(s) to follow up on:\033[0m\n' "${#FOLLOWUPS[@]}"
    for entry in "${FOLLOWUPS[@]}"; do
      printf '\033[1;36m    → %s\033[0m\n' "$entry"
    done
  fi
}
trap summarize EXIT

printf '\033[1;32mGood morning! Today is %s\033[0m\n' "$(date '+%A, %B %-d %Y')"

step "Updating dotfiles"
# A dirty tree or a failed pull shouldn't take the rest of the morning with it.
"$DOTFILES/install.sh" --force || warn "dotfiles update failed, continuing"

step "Updating Homebrew packages"
# Upstream cask renames/breakage are routine and shouldn't abort the whole run.
# Homebrew 4.6+ asks to confirm upgrades by default, which stalls an unattended
# run. HOMEBREW_NO_ASK rather than --yes so a brew predating the flag ignores it
# instead of erroring on an unknown option.
brew update && HOMEBREW_NO_ASK=1 brew upgrade \
  || warn "brew upgrade had failures, continuing"

step "Cleaning up Homebrew"
brew cleanup || warn "brew cleanup had failures, continuing"

step "Checking gcloud auth"
if command -v gcloud > /dev/null 2>&1; then
  active_account=$(gcloud auth list --filter='status=ACTIVE' --format='value(account)' 2>/dev/null || true)
  if [[ -z "$active_account" ]]; then
    note "No active gcloud account — starting login..."
    gcloud auth login || warn "gcloud login failed, continuing"
    active_account=$(gcloud auth list --filter='status=ACTIVE' --format='value(account)' 2>/dev/null || true)
  fi
  # Report what is actually true: a blocked or cancelled login used to leave
  # these printing an empty account and a confident "valid".
  if [[ -n "$active_account" ]]; then
    ok "gcloud user: $active_account"
  else
    recommend "gcloud still not authenticated — run: gcloud auth login"
  fi
  if ! gcloud auth application-default print-access-token > /dev/null 2>&1; then
    note "No application-default credentials — starting ADC login..."
    gcloud auth application-default login || warn "gcloud ADC login failed, continuing"
  fi
  if gcloud auth application-default print-access-token > /dev/null 2>&1; then
    ok "gcloud ADC: valid"
  else
    recommend "gcloud ADC unavailable — run: gcloud auth application-default login"
  fi
else
  warn "gcloud not installed, skipping"
fi

step "Checking GitHub auth"
if command -v gh > /dev/null 2>&1; then
  if ! gh auth status > /dev/null 2>&1; then
    note "Not authenticated with GitHub — starting login..."
    gh auth login || warn "GitHub login failed, continuing"
  fi
  gh_user=$(gh api user --jq '.login' 2>/dev/null || true)
  if [[ -n "$gh_user" ]]; then
    ok "GitHub: $gh_user"
  else
    recommend "GitHub still not authenticated — run: gh auth login"
  fi
else
  warn "gh not installed, skipping"
fi

step "Updating gcloud components"
if command -v gcloud > /dev/null 2>&1; then
  gcloud components update --quiet || warn "gcloud components update failed, continuing"
else
  warn "gcloud not installed, skipping"
fi

step "Pulling latest repos"
while IFS= read -r -d '' dir; do
  repo=$(basename "$dir")
  # Deliberately not stashed or reset -- see rule 3. Surfaced as a follow-up so
  # a repo doesn't sit unpulled for weeks without anyone noticing.
  if ! git -C "$dir" diff --quiet || ! git -C "$dir" diff --cached --quiet; then
    recommend "$repo: uncommitted changes, not pulled — commit or stash"
    continue
  fi
  printf '  pulling %s...\n' "$repo"
  git -C "$dir" pull --ff-only || warn "$repo: pull failed"
done < <(find "$CODE" -maxdepth 1 -mindepth 1 -type d -exec test -d '{}/.git' \; -print0 | sort -z)

step "Updating Node.js LTS"
if [[ -f "$NVM_DIR/nvm.sh" ]]; then
  # nvm is a shell function; source it explicitly in non-interactive scripts.
  # Its internals reference unset vars (e.g. PROVIDED_VERSION), so nounset has
  # to stay off while running nvm too, not just while sourcing it.
  set +u
  source "$NVM_DIR/nvm.sh" 2>/dev/null
  # Guarded so a failure can't skip the `set -u` below and leave the rest of
  # the run without nounset.
  nvm install --lts || warn "nvm install failed, continuing"
  set -u
else
  warn "nvm not installed, skipping"
fi

if [[ -d "$CODE/platform" ]]; then
  step "Installing platform dependencies"
  # Endpoint security software on the work machine intermittently blocks or
  # quarantines files mid-install, so this step fails there in ways that say
  # nothing about the rest of the run. Warn and keep going.
  (cd "$CODE/platform" && corepack pnpm install --frozen-lockfile) \
    || warn "platform dependency install failed, continuing"
fi

step "Updating agent skills"
if npx --no-install skills --version > /dev/null 2>&1; then
  # --yes so a missing dependency can't stall at npx's install confirmation.
  npx --yes skills update -g || warn "skills update failed, continuing"
else
  warn "skills not installed, skipping"
fi

step "Pruning Docker"
if ! command -v docker > /dev/null 2>&1; then
  warn "docker not installed, skipping"
elif ! docker info > /dev/null 2>&1; then
  warn "Docker not running, skipping prune"
else
  docker system prune -f --filter "until=24h" || warn "docker prune failed, continuing"
fi
