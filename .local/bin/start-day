#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/code/dotfiles}"
CODE="${CODE:-$HOME/code}"
NVM_DIR="${NVM_DIR:-$HOME/.config/nvm}"

step() {
  printf '\n\033[1;34m==> %s\033[0m\n' "$*"
}

warn() {
  printf '\033[1;33m  ! %s\033[0m\n' "$*"
}

ok() {
  printf '\033[1;32m  ✓ %s\033[0m\n' "$*"
}

printf '\033[1;32mGood morning! Today is %s\033[0m\n' "$(date '+%A, %B %-d %Y')"

step "Updating dotfiles"
# A dirty tree or a failed pull shouldn't take the rest of the morning with it.
"$DOTFILES/install.sh" --force || warn "dotfiles update failed, continuing"

step "Updating Homebrew packages"
# Upstream cask renames/breakage are routine and shouldn't abort the whole run.
brew update && brew upgrade || warn "brew upgrade had failures, continuing"

step "Cleaning up Homebrew"
brew cleanup || warn "brew cleanup had failures, continuing"

step "Checking gcloud auth"
if command -v gcloud > /dev/null 2>&1; then
  active_account=$(gcloud auth list --filter='status=ACTIVE' --format='value(account)' 2>/dev/null || true)
  if [[ -z "$active_account" ]]; then
    warn "No active gcloud account — starting login..."
    gcloud auth login || warn "gcloud login failed, continuing"
    active_account=$(gcloud auth list --filter='status=ACTIVE' --format='value(account)' 2>/dev/null || true)
  fi
  # Report what is actually true: a blocked or cancelled login used to leave
  # these printing an empty account and a confident "valid".
  if [[ -n "$active_account" ]]; then
    ok "gcloud user: $active_account"
  else
    warn "gcloud user: still not authenticated"
  fi
  if ! gcloud auth application-default print-access-token > /dev/null 2>&1; then
    warn "No application-default credentials — starting ADC login..."
    gcloud auth application-default login || warn "gcloud ADC login failed, continuing"
  fi
  if gcloud auth application-default print-access-token > /dev/null 2>&1; then
    ok "gcloud ADC: valid"
  else
    warn "gcloud ADC: still unavailable"
  fi
else
  warn "gcloud not installed, skipping"
fi

step "Checking GitHub auth"
if command -v gh > /dev/null 2>&1; then
  if ! gh auth status > /dev/null 2>&1; then
    warn "Not authenticated with GitHub — starting login..."
    gh auth login || warn "GitHub login failed, continuing"
  fi
  gh_user=$(gh api user --jq '.login' 2>/dev/null || true)
  if [[ -n "$gh_user" ]]; then
    ok "GitHub: $gh_user"
  else
    warn "GitHub: still not authenticated"
  fi
else
  warn "gh not installed, skipping"
fi

step "Updating gcloud components"
if command -v gcloud > /dev/null 2>&1; then
  gcloud components update --quiet || warn "gcloud components update failed, continuing"
else
  warn "gcloud not installed, skipping"
fi

step "Pulling latest repos"
while IFS= read -r -d '' dir; do
  repo=$(basename "$dir")
  if ! git -C "$dir" diff --quiet || ! git -C "$dir" diff --cached --quiet; then
    warn "$repo: has uncommitted changes, skipping pull"
    continue
  fi
  printf '  pulling %s...\n' "$repo"
  git -C "$dir" pull --ff-only || warn "$repo: pull failed"
done < <(find "$CODE" -maxdepth 1 -mindepth 1 -type d -exec test -d '{}/.git' \; -print0 | sort -z)

step "Updating Node.js LTS"
if [[ -f "$NVM_DIR/nvm.sh" ]]; then
  # nvm is a shell function; source it explicitly in non-interactive scripts.
  # Its internals reference unset vars (e.g. PROVIDED_VERSION), so nounset has
  # to stay off while running nvm too, not just while sourcing it.
  set +u
  source "$NVM_DIR/nvm.sh" 2>/dev/null
  # Guarded so a failure can't skip the `set -u` below and leave the rest of
  # the run without nounset.
  nvm install --lts || warn "nvm install failed, continuing"
  set -u
else
  warn "nvm not installed, skipping"
fi

if [[ -d "$CODE/platform" ]]; then
  step "Installing platform dependencies"
  # Endpoint security software on the work machine intermittently blocks or
  # quarantines files mid-install, so this step fails there in ways that say
  # nothing about the rest of the run. Warn and keep going.
  (cd "$CODE/platform" && corepack pnpm install --frozen-lockfile) \
    || warn "platform dependency install failed, continuing"
fi

step "Updating agent skills"
if npx --no-install skills --version > /dev/null 2>&1; then
  npx skills update -g || warn "skills update failed, continuing"
else
  warn "skills not installed, skipping"
fi

step "Pruning Docker"
if ! command -v docker > /dev/null 2>&1; then
  warn "docker not installed, skipping"
elif ! docker info > /dev/null 2>&1; then
  warn "Docker not running, skipping prune"
else
  docker system prune -f --filter "until=24h" || warn "docker prune failed, continuing"
fi
