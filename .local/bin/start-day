#!/usr/bin/env bash
#
# Morning convergence run. Three rules govern everything here:
#
#   1. No step may end the run. Failures warn and continue.
#   2. Nothing may prompt, so it can be left to finish on its own. Auth is the
#      deliberate exception: a login has to be interactive, and there is no
#      point converging a machine you cannot then use.
#   3. Nothing destructive. Anything that would discard work is reported rather
#      than done -- e.g. repos with uncommitted changes are skipped, not stashed.
#
# The summary at the end has two halves, so an unattended run can be reviewed in
# one place: warn() records what went wrong, and recommend() records what is
# left for you to do, with the command to do it.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/code/dotfiles}"
CODE="${CODE:-$HOME/code}"
NVM_DIR="${NVM_DIR:-$HOME/.config/nvm}"
# Deliberately not defaulted: a Spacelift endpoint names a specific account, so
# it belongs to the machine rather than to this repo. Set it in
# ~/.config/shell/secrets, which isn't tracked here. It's spacectl's own
# variable, so the same value works for a hand-run `spacectl profile login`.
SPACECTL_LOGIN_ENDPOINT="${SPACECTL_LOGIN_ENDPOINT:-}"

# Make git fail rather than sit at a credential prompt. This isn't the auth
# exception above: that covers the deliberate login steps, whereas this would be
# an opaque stall partway through pulling dozens of repos. A repo that needs
# credentials warns and shows up in the summary instead. Exported so the pull
# inside install.sh inherits it too.
export GIT_TERMINAL_PROMPT=0

# Corepack otherwise asks before downloading a package manager it doesn't have.
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

CURRENT_STEP=""
STEP_COUNT=0
ISSUES=()
FOLLOWUPS=()

step() {
  CURRENT_STEP="$*"
  STEP_COUNT=$((STEP_COUNT + 1))
  printf '\n\033[1;34m==> %s\033[0m\n' "$*"
}

# Warnings print inline for the audit trail and are buffered for the summary,
# since the run is long enough that one 200 lines up is easy to miss.
warn() {
  printf '\033[1;33m  ! %s\033[0m\n' "$*"
  ISSUES+=("${CURRENT_STEP:-start-day}: $*")
}

# Something the run can't do for you, either because it needs a decision or
# because it would be destructive to do unasked. Carries the command to run.
recommend() {
  printf '\033[1;36m  → %s\033[0m\n' "$*"
  FOLLOWUPS+=("$*")
}

# Inline-only: progress chatter that isn't itself a problem, like announcing a
# login prompt. Whether the login then worked is reported separately.
note() {
  printf '\033[1;33m  ! %s\033[0m\n' "$*"
}

ok() {
  printf '\033[1;32m  ✓ %s\033[0m\n' "$*"
}

# On EXIT so the summary still lands if something unexpected kills the run.
summarize() {
  local status=$?
  local entry

  printf '\n\033[1;34m==> Summary\033[0m\n'

  # Nothing should abort the run any more, so if one did, say so rather than
  # letting a short run look like a clean one.
  if [ "$status" -ne 0 ]; then
    printf '\033[1;31m  ✗ run ended early during "%s" (exit %s)\033[0m\n' \
      "${CURRENT_STEP:-startup}" "$status"
  fi

  # macOS ships bash 3.2, where expanding an empty array under `set -u` is an
  # error, so every count is checked before anything expands the array.
  if [ "${#ISSUES[@]}" -eq 0 ] && [ "${#FOLLOWUPS[@]}" -eq 0 ]; then
    if [ "$status" -eq 0 ]; then
      printf '\033[1;32m  ✓ %s steps, nothing to report\033[0m\n' "$STEP_COUNT"
    fi
    return
  fi

  if [ "${#ISSUES[@]}" -gt 0 ]; then
    printf '\033[1;33m  %s warning(s) across %s steps:\033[0m\n' \
      "${#ISSUES[@]}" "$STEP_COUNT"
    for entry in "${ISSUES[@]}"; do
      printf '\033[1;33m    ! %s\033[0m\n' "$entry"
    done
  fi

  # Listed last so it's the final thing on screen -- this is the part that
  # wants acting on, as opposed to the warnings, which are a record.
  if [ "${#FOLLOWUPS[@]}" -gt 0 ]; then
    printf '\033[1;36m  %s thing(s) to follow up on:\033[0m\n' "${#FOLLOWUPS[@]}"
    for entry in "${FOLLOWUPS[@]}"; do
      printf '\033[1;36m    → %s\033[0m\n' "$entry"
    done
  fi
}
trap summarize EXIT

printf '\033[1;32mGood morning! Today is %s\033[0m\n' "$(date '+%A, %B %-d %Y')"

step "Updating dotfiles"
# A dirty tree or a failed pull shouldn't take the rest of the morning with it.
"$DOTFILES/install.sh" --force || warn "dotfiles update failed, continuing"

step "Updating Homebrew packages"
# Upstream cask renames/breakage are routine and shouldn't abort the whole run.
# Homebrew 4.6+ asks to confirm upgrades by default, which stalls an unattended
# run. HOMEBREW_NO_ASK rather than --yes so a brew predating the flag ignores it
# instead of erroring on an unknown option.
brew update && HOMEBREW_NO_ASK=1 brew upgrade \
  || warn "brew upgrade had failures, continuing"

step "Cleaning up Homebrew"
# --prune=all because bare `brew cleanup` keeps downloads for 120 days
# (HOMEBREW_CLEANUP_MAX_AGE_DAYS), so running it daily reclaims nothing while
# the bottle cache grows without bound -- 11 GB of it when this was added. What
# that costs is reinstalling a current version offline, which is rarer than
# needing the space; brew re-fetches on demand.
brew cleanup --prune=all || warn "brew cleanup had failures, continuing"

step "Checking 1Password auth"
if command -v op > /dev/null 2>&1; then
  # First among the auth steps because shell plugins let 1Password hand
  # credentials to the other CLIs, so anything wired that way needs this session
  # to exist first.
  #
  # `op signin` is idempotent -- it prompts only when the session is missing --
  # so it can be called unconditionally, but the probe stays for the same reason
  # the gcloud one does: it tells the difference between "already fine" and "a
  # login just happened", and a cancelled prompt has to report as unsigned-in
  # rather than as success.
  op_account=$(op whoami --format=json 2>/dev/null || true)
  if [[ -z "$op_account" ]]; then
    note "Not signed in to 1Password — starting sign-in..."
    # Needs the desktop app running with "Integrate with 1Password CLI" on;
    # without it this fails immediately rather than hanging, which is the right
    # trade for an unattended run.
    op signin || warn "1Password sign-in failed, continuing"
    op_account=$(op whoami --format=json 2>/dev/null || true)
  fi
  if [[ -n "$op_account" ]]; then
    # jq only decorates the message, so a machine without it still reports
    # signed-in rather than dropping the step.
    op_email=$(printf '%s' "$op_account" | jq -r '.email // empty' 2>/dev/null || true)
    ok "1Password: ${op_email:-signed in}"
  else
    recommend "1Password still not signed in — run: op signin"
  fi
else
  warn "op not installed, skipping"
fi

step "Checking gcloud auth"
if command -v gcloud > /dev/null 2>&1; then
  # `gcloud auth list` only reads the local credential store, so it keeps
  # reporting an account ACTIVE after its session has expired under the org's
  # reauth policy -- the credentials are still on disk, they just no longer
  # refresh. Minting a token is the only probe that fails when a real command
  # would. Stdin is closed so a reauth challenge fails fast here instead of
  # hanging behind the suppressed output; the login below does the prompting
  # where it can actually be seen and answered.
  if ! gcloud auth print-access-token < /dev/null > /dev/null 2>&1; then
    note "gcloud credentials missing or expired — starting login..."
    gcloud auth login || warn "gcloud login failed, continuing"
  fi
  # Report what is actually true: a blocked or cancelled login used to leave
  # these printing an empty account and a confident "valid".
  if gcloud auth print-access-token < /dev/null > /dev/null 2>&1; then
    active_account=$(gcloud auth list --filter='status=ACTIVE' --format='value(account)' 2>/dev/null || true)
    ok "gcloud user: ${active_account:-authenticated}"
  else
    recommend "gcloud still not authenticated — run: gcloud auth login"
  fi
  if ! gcloud auth application-default print-access-token < /dev/null > /dev/null 2>&1; then
    note "No application-default credentials — starting ADC login..."
    gcloud auth application-default login || warn "gcloud ADC login failed, continuing"
  fi
  if gcloud auth application-default print-access-token < /dev/null > /dev/null 2>&1; then
    ok "gcloud ADC: valid"
  else
    recommend "gcloud ADC unavailable — run: gcloud auth application-default login"
  fi
else
  warn "gcloud not installed, skipping"
fi

step "Checking GitHub auth"
if command -v gh > /dev/null 2>&1; then
  if ! gh auth status > /dev/null 2>&1; then
    note "Not authenticated with GitHub — starting login..."
    gh auth login || warn "GitHub login failed, continuing"
  fi
  gh_user=$(gh api user --jq '.login' 2>/dev/null || true)
  if [[ -n "$gh_user" ]]; then
    ok "GitHub: $gh_user"
  else
    recommend "GitHub still not authenticated — run: gh auth login"
  fi
else
  warn "gh not installed, skipping"
fi

step "Checking Claude auth"
if command -v claude > /dev/null 2>&1; then
  # `claude auth status` only reads the local credential store, so it keeps
  # reporting loggedIn after the session behind those credentials has stopped
  # working -- the same gap as `gcloud auth list`. Sending one token to Haiku with
  # no tools and no MCP servers is the cheapest thing that actually round-trips
  # the API, and it fails exactly when an interactive session would.
  #
  # ANTHROPIC_API_KEY is cleared for the probe deliberately: it would answer for
  # the API instead of the account, so an expired login would pass here and then
  # fail the moment a session tried to use the subscription.
  claude_probe() {
    env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN \
      claude -p ok --model haiku --allowedTools '' --strict-mcp-config \
      < /dev/null > /dev/null 2>&1
  }
  claude_authed=0
  if claude_probe; then
    claude_authed=1
  else
    note "Claude credentials missing or expired — starting login..."
    # --claudeai keeps this on the subscription. The alternative (--console) is
    # usage-billed API access, which isn't what the interactive CLI should use.
    claude auth login --claudeai || warn "Claude login failed, continuing"
    # Re-probed rather than trusting the login's exit status, and stored so the
    # happy path stays at one round-trip a morning.
    if claude_probe; then claude_authed=1; fi
  fi
  claude_status=$(claude auth status --json 2>/dev/null || true)
  if [ "$claude_authed" -eq 1 ]; then
    # jq only decorates the message, as in the 1Password step above.
    claude_email=$(printf '%s' "$claude_status" | jq -r '.email // empty' 2>/dev/null || true)
    ok "Claude: ${claude_email:-authenticated}"
  else
    recommend "Claude still not authenticated — run: claude auth login"
  fi
  # Reported, not unset: the variable is presumably exported on purpose, but it
  # outranks the account login in every session, so it's worth saying out loud.
  claude_key_source=$(printf '%s' "$claude_status" | jq -r '.apiKeySource // empty' 2>/dev/null || true)
  if [[ -n "$claude_key_source" ]]; then
    recommend "Claude is billing the API via $claude_key_source, not the account login — unset it to use the subscription"
  fi
else
  warn "claude not installed, skipping"
fi

step "Checking Copilot auth"
if command -v copilot > /dev/null 2>&1; then
  # Copilot CLI has no status command, and `copilot login` is not idempotent --
  # it opens a fresh browser OAuth flow every time it's called, so unlike
  # `op signin` it can't be run unconditionally. That leaves a prompt as the only
  # probe. Same shape as the Claude one: Haiku, no tools, no MCP servers, which
  # is roughly one AI credit a morning. --no-auto-update because Homebrew owns
  # this binary and the CLI otherwise tries to replace it from under brew.
  #
  # The token variables are cleared for the same reason ANTHROPIC_API_KEY is
  # above; all three take precedence over the stored OAuth session.
  copilot_probe() {
    env -u COPILOT_GITHUB_TOKEN -u GH_TOKEN -u GITHUB_TOKEN \
      copilot -p ok --model claude-haiku-4.5 --available-tools '' \
      --disable-builtin-mcps --allow-all-tools --no-auto-update --log-level none \
      < /dev/null > /dev/null 2>&1
  }
  copilot_authed=0
  if copilot_probe; then
    copilot_authed=1
  else
    note "Copilot credentials missing or expired — starting login..."
    copilot login || warn "Copilot login failed, continuing"
    if copilot_probe; then copilot_authed=1; fi
  fi
  if [ "$copilot_authed" -eq 1 ]; then
    ok "Copilot: authenticated"
  else
    recommend "Copilot still not authenticated — run: copilot login"
  fi
  for copilot_token_var in COPILOT_GITHUB_TOKEN GH_TOKEN GITHUB_TOKEN; do
    if [[ -n "${!copilot_token_var:-}" ]]; then
      recommend "Copilot is using \$$copilot_token_var instead of the account login — unset it to use the OAuth session"
      break
    fi
  done
else
  warn "copilot not installed, skipping"
fi

step "Checking Spacelift auth"
if ! command -v spacectl > /dev/null 2>&1; then
  warn "spacectl not installed, skipping"
elif [[ -z "$SPACECTL_LOGIN_ENDPOINT" ]]; then
  # Not a warning: without an endpoint there is no account to check, and a
  # machine that doesn't do Spacelift work shouldn't be nagged every morning.
  note "SPACECTL_LOGIN_ENDPOINT not set, skipping"
else
  # The profile alias is local and arbitrary, so it's derived from the endpoint
  # rather than configured separately -- one account, one profile, and no second
  # variable to keep in sync. https://acme.app.eu.spacelift.io -> acme.
  spacectl_alias=${SPACECTL_LOGIN_ENDPOINT#*://}
  spacectl_alias=${spacectl_alias%%/*}
  spacectl_alias=${spacectl_alias%%.*}
  # `spacectl profile current` only names the selected profile -- it keeps
  # naming one long after that profile's token has expired, the same gap as
  # `gcloud auth list`. `whoami` is the cheapest call that actually round-trips
  # the API, so it fails exactly when a stack command would, and it's free.
  # Stdin is closed so nothing can stall behind the suppressed output.
  #
  # Unlike the agent CLIs above, the SPACELIFT_API_* environment variables are
  # left alone for the probe: there's no billing difference between a key and a
  # profile token, so if a key is set and works, spacectl works, which is all
  # this step is asking.
  spacectl_probe() {
    spacectl whoami < /dev/null > /dev/null 2>&1
  }
  if ! spacectl_probe; then
    note "Spacelift credentials missing or expired — starting login..."
    # --endpoint and --method skip the two prompts that would otherwise come
    # before the browser opens; the SSO flow itself is the interactive part,
    # which is the auth exception.
    spacectl profile login --method browser --endpoint "$SPACECTL_LOGIN_ENDPOINT" \
      "$spacectl_alias" || warn "Spacelift login failed, continuing"
  fi
  if spacectl_probe; then
    ok "Spacelift: $spacectl_alias"
  else
    recommend "Spacelift still not authenticated — run: spacectl profile login $spacectl_alias"
  fi
fi

step "Updating gcloud components"
if command -v gcloud > /dev/null 2>&1; then
  gcloud components update --quiet || warn "gcloud components update failed, continuing"
else
  warn "gcloud not installed, skipping"
fi

step "Pulling latest repos"
while IFS= read -r -d '' dir; do
  repo=$(basename "$dir")
  # Deliberately not stashed or reset -- see rule 3. Surfaced as a follow-up so
  # a repo doesn't sit unpulled for weeks without anyone noticing.
  if ! git -C "$dir" diff --quiet || ! git -C "$dir" diff --cached --quiet; then
    recommend "$repo: uncommitted changes, not pulled — commit or stash"
    continue
  fi
  printf '  pulling %s...\n' "$repo"
  git -C "$dir" pull --ff-only || warn "$repo: pull failed"
done < <(find "$CODE" -maxdepth 1 -mindepth 1 -type d -exec test -d '{}/.git' \; -print0 | sort -z)

step "Updating Node.js LTS"
if [[ -f "$NVM_DIR/nvm.sh" ]]; then
  # nvm is a shell function; source it explicitly in non-interactive scripts.
  # Its internals reference unset vars (e.g. PROVIDED_VERSION), so nounset has
  # to stay off while running nvm too, not just while sourcing it.
  set +u
  source "$NVM_DIR/nvm.sh" 2>/dev/null
  # Guarded so a failure can't skip the `set -u` below and leave the rest of
  # the run without nounset.
  nvm install --lts || warn "nvm install failed, continuing"
  set -u
else
  warn "nvm not installed, skipping"
fi

if [[ -d "$CODE/platform" ]]; then
  step "Installing platform dependencies"
  # Endpoint security software on the work machine intermittently blocks or
  # quarantines files mid-install, so this step fails there in ways that say
  # nothing about the rest of the run. Warn and keep going.
  (cd "$CODE/platform" && corepack pnpm install --frozen-lockfile) \
    || warn "platform dependency install failed, continuing"
fi

step "Updating agent skills"
if npx --no-install skills --version > /dev/null 2>&1; then
  # --yes so a missing dependency can't stall at npx's install confirmation.
  npx --yes skills update -g || warn "skills update failed, continuing"
else
  warn "skills not installed, skipping"
fi

step "Pruning tool caches"
# Grouped into one step, and silent about tools that aren't installed, unlike
# the checks elsewhere in the run. Those cover tooling both machines are
# expected to have, so a missing one is worth a warning; these are incidental
# caches, and whether a machine has uv at all isn't news every morning. A tool
# that is present and then fails still warns.
#
# Each of these is the tool's own garbage collector, which is what keeps them on
# the right side of rule 3 -- they drop unreferenced entries, not entries some
# project still depends on.
pruned=0
prune_cache() {
  local tool=$1
  shift
  command -v "$tool" > /dev/null 2>&1 || return 0
  pruned=$((pruned + 1))
  printf '  pruning %s...\n' "$tool"
  "$tool" "$@" || warn "$tool cache prune failed, continuing"
}
prune_cache npm cache verify
prune_cache pre-commit gc
prune_cache uv cache prune
if [ "$pruned" -eq 0 ]; then
  note "no cache tools installed, skipping"
fi

step "Deleting unavailable simulators"
# Simulators whose runtime Xcode has since removed. They cannot be booted, so
# this isn't rule 3 territory the way deleting a working simulator would be --
# and they accumulate every Xcode update (116 of them when this was added).
#
# Probing for simctl specifically, not xcrun: a machine with only the Command
# Line Tools has xcrun but no simctl, and would fail here every morning.
if xcrun --find simctl > /dev/null 2>&1; then
  xcrun simctl delete unavailable || warn "simulator cleanup failed, continuing"
else
  note "simctl not available, skipping"
fi

step "Pruning Docker"
if ! command -v docker > /dev/null 2>&1; then
  warn "docker not installed, skipping"
elif ! docker info > /dev/null 2>&1; then
  warn "Docker not running, skipping prune"
else
  docker system prune -f --filter "until=24h" || warn "docker prune failed, continuing"
fi
