# vi: ft=sh
#
# Bash-only settings. The shared config in shell/ is already sourced by
# shell/profile before .bashrc gets here.

export HISTCONTROL=ignoredups

# Bash-only history vars (zsh uses SAVEHIST/EXTENDED_HISTORY instead).
export HISTFILESIZE=$HISTSIZE
export HISTTIMEFORMAT="[%F %T] "

# Fix issue with Git commit signing.
# export GPG_TTY=$(tty)

# Use XDG directories.
export HISTFILE="$XDG_CACHE_HOME/bash/history"

# Show hostname in prompt if we're SSH'ing.
host=""
if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
  host="(\h) "
fi

export PS1="${host}\[\033[33;1m\]\W\[\033[m\] $ "

export PROJECT_HOME=$HOME/code
export PROMPT_TOOLKIT_ANSI_COLORS_ONLY=1
