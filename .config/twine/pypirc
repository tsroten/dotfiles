# PyPI dropped username/password uploads: the only supported credential is an
# API token, used with the literal username __token__. Tokens themselves stay
# out of this file -- twine reads them from the keyring, or from TWINE_PASSWORD.
[distutils]
index-servers =
    pypi
    testpypi

[pypi]
repository = https://upload.pypi.org/legacy/
username = __token__

[testpypi]
repository = https://test.pypi.org/legacy/
username = __token__
